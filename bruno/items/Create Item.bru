meta {
  name: Create Item
  type: http
  seq: 1
}

post {
  url: {{api_v1}}/items
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Notebook",
    "description": "A ruled notebook"
  }
}

script:post-response {
  if (res.getStatus() !== 201) {
    return;
  }
  const body = res.getBody();
  if (body && body.id) {
    bru.setEnvVar("item_id", body.id);
  }
}

docs {
  Creates an item. Bare 201 JSON body with `id`, `name`, `description`, timestamps.
  Saves `item_id` into the active environment for follow-up requests.
}
